<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Brisa Suave OS</vendor>
  <action id="org.brisa.helper">
    <description>Ajustes do Brisa Suave OS (modos, data e hora, atualizações e loja)</description>
    <message>O Brisa Suave OS precisa de permissão para fazer este ajuste</message>
    <icon_name>preferences-system</icon_name>
    <defaults>
      <!-- quem está usando o aparelho na frente da tela não precisa digitar senha;
           o ajudante só aceita os pedidos da lista dele -->
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/brisa/brisa-helper</annotate>
  </action>
</policyconfig>
